# compose (postgres + app)
POSTGRES_DB=error_free_text
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
APP_PORT=8080

# база
DB_URL=jdbc:postgresql://localhost:5432/error_free_text
DB_USER=postgres
DB_PASSWORD=postgres
DB_DDL_AUTO=update

# яндекс спеллер
YANDEX_SPELLER_URL=https://speller.yandex.net/services/spellservice.json/checkTexts

# шедулер
SCHEDULER_INTERVAL_MS=5000

# логи
APP_LOG_LEVEL=INFO
JPA_SHOW_SQL=false
